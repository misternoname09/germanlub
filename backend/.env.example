# Configuration SMTP (Exemple pour Gmail)
# Copiez ce fichier, renommez-le en ".env" et remplissez vos informations

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Votre adresse e-mail complète
EMAIL_HOST_USER=votre.email@gmail.com

# Votre mot de passe d'application (PAS votre vrai mot de passe Gmail)
EMAIL_HOST_PASSWORD=votre_mot_de_passe_d_application

# L'adresse qui apparaîtra comme expéditeur
DEFAULT_FROM_EMAIL=GermanLub Shop <votre.email@gmail.com>

# --- Sécurité Django ---
SECRET_KEY=remplacez_ceci_par_une_cle_secrete_aleatoire_et_longue
DEBUG=False
ALLOWED_HOSTS=votre_domaine.com,www.votre_domaine.com
CORS_ALLOWED_ORIGINS=https://votre_domaine.com

# Base de Données (PostgreSQL)
# Remplissez cette ligne lors du passage en production avec vos vrais accès
DATABASE_URL=postgres://votre_user_postgres:votre_mdp_postgres@localhost:5432/germanlub_db
